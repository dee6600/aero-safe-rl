# Python
__pycache__/
*.py[cod]
*.egg-info/

# Conda / venv (env lives outside the repo, but ignore if ever created locally).
# Anchored to the repo root (leading /) -- an unanchored "env/" also matched
# configs/env/ at any depth, which silently hid configs/env/farm.yaml (M4)
# from git entirely. Found live while adding that file.
.venv/
/env/

# ROS 2 / colcon
build/
install/
log/

# PX4 logs
*.ulg

# ROS2 workspace log dir (colcon build/install already covered above)
ros2_ws/log/

# Model checkpoints
*.pt
*.pth
*.zip

# Results and large artifacts
results/

# Editor / OS
.vscode/
.DS_Store
