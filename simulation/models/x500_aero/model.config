<?xml version="1.0"?>
<model>
  <name>x500_aero</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>aero-safe-rl</name>
  </author>
  <description>
    x500 with rotor-degradation fault injection (M6). Identical to PX4's own
    x500 model (Tools/simulation/gz/models/x500, ~/projects/PX4-Autopilot,
    never modified in place) except each rotor's stock
    gz-sim-multicopter-motor-model-system plugin subscribes to a relayed
    command topic instead of the real one, and one new
    RotorDegradationSystem plugin sits in between -- see
    simulation/gz_plugins/src/RotorDegradationSystem.cc for the full design.
  </description>
</model>
